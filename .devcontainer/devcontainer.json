{
  "name": "Java Jupyter Notebook Env",
  "image": "://microsoft.com",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installJupyterlab": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "postCreateCommand": "pip install jbang && jbang install-kernel@jupyter-java"
}